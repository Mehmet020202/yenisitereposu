# =====================================================================
# ALTUG KUYUMCULUK - Ortam Degiskenleri ORNEGI
# =====================================================================
# !! Bu dosyayi OLDUGU GIBI kopyalayip .env yapmayin.
# !! Gercek degerler KULLANICININ BILGISAYARINDA TUTULMAZ:
#    - Google Cloud Secret Manager'a yuklenir (talimat: README.md, Bolum 4)
#    - Cloud Run hizmeti bu secret'lari dagitimda okur.
# .env.example icindeki degerler PLACEHOLDER'dir, secret degildir.
# =====================================================================

# --- Firebase Realtime Database (bulut yazar) ---
# Firebase Console > Project Settings > General > Project ID
FB_PROJECT_ID=altug-kuyumculuk

# Firebase Console > Project Settings > Service accounts >
#   "Generate new private key" ile indirilen JSON icinden:
#   client_email ve private_key alanlari. private_key icindeki
#   satir sonlari \n olarak yazilmalidir.
FB_CLIENT_EMAIL=price-ingestion@altug-kuyumculuk.iam.gserviceaccount.com
FB_PRIVATE_KEY="***\n"

# Firebase Console > Realtime Database > URL (europe-west1 onerilir)
FB_DATABASE_URL=https://altug-kuyumculuk-default-rtdb.europe-west1.firebasedatabase.app

# --- Harem Altin Socket.IO ---
HAREM_SOCKET_URL=https://socket.haremaltin.com
HAREM_SYMBOLS=ALTIN,USDTRY,EURTRY

# Abone olma protokol adi. Degerler:
#   subscribe-array | subscribe-object | join
# Ilk calismada log'dan hangisinin kabul edildigi DOGRULANMALI.
HAREM_SUBSCRIBE_PROTOCOL=subscribe-array

# --- Dogrulama ---
# Ani yuzde 30'dan buyuk fiyat sicramasi reddedilir (1.0 = %100).
MAX_JUMP_RATIO=0.30

# --- Cloud Run saglik kontrolu portu (Cloud Run PORT'u kendisi verir) ---
PORT=8080
