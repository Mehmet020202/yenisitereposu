{
  "rules": {
    ".read": false,
    ".write": false,

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()",
      "usdShowMode": { ".validate": "newData.isString() && newData.val().matches(/^(buy|sell|both)$/)" },
      "eurShowMode": { ".validate": "newData.isString() && newData.val().matches(/^(buy|sell|both)$/)" },
      "goldDisplayMode": { ".validate": "newData.isString() && newData.val().matches(/^(buy|sell|both)$/)" },
      "activeUserTheme": { ".validate": "newData.isString() && newData.val().matches(/^theme-[0-9]+$/)" },
      "prevUserTheme": { ".validate": "newData.isString() && newData.val().matches(/^theme-[0-9]+$/)" }
    },

    "marketPrices": {
      ".read": true,
      ".write": "auth != null && (auth.uid == 'ingest-service' || (root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()))",
      "hasBuy": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "hasSell": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "usdBuy": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "usdSell": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "eurBuy": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "eurSell": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "source": { ".validate": "newData.isString() && newData.val().matches(/^(harem|browser-fallback|admin-live-sync)$/)" },
      "marketTime": { ".validate": "!newData.exists() || newData.isNumber()" },
      "hasBuyDir": { ".validate": "newData.val() == 'up' || newData.val() == 'down'" },
      "hasSellDir": { ".validate": "newData.val() == 'up' || newData.val() == 'down'" },
      "usdBuyDir": { ".validate": "newData.val() == 'up' || newData.val() == 'down'" },
      "usdSellDir": { ".validate": "newData.val() == 'up' || newData.val() == 'down'" },
      "eurBuyDir": { ".validate": "newData.val() == 'up' || newData.val() == 'down'" },
      "eurSellDir": { ".validate": "newData.val() == 'up' || newData.val() == 'down'" },
      ".indexOn": ["updatedAt"]
    },

    "currencyAdjustments": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()"
    },

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'buyMultiplier', 'sellMultiplier'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "buyMultiplier": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1000" },
        "sellMultiplier": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1000" },
        "order": { ".validate": "!newData.exists() || newData.isNumber()" },
        "archived": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "active": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "tvVisible": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "imageUrl": { ".validate": "!newData.exists() || newData.isString()" }
      }
    },

    "advertisements": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()"
    },

    "branding": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()"
    },

    "connectionStatus": {
      ".read": true,
      ".write": "auth != null && (auth.uid == 'ingest-service' || (root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()))"
    },

    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && data.child('rootAdminUid').exists() && data.child('rootAdminUid').val() != '' && auth.uid == data.child('rootAdminUid').val()",
      "rootAdminUid": {
        ".validate": "newData.isString() && newData.val().length >= 10"
      }
    },

    "operationLogs": {
      ".read": "auth != null && root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()",
      ".write": "auth != null && root.child('admins').child('rootAdminUid').exists() && root.child('admins').child('rootAdminUid').val() != '' && auth.uid == root.child('admins').child('rootAdminUid').val()",
      ".indexOn": ["at"]
    }
  }
}
