<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ALTUĞ KUYUMCULUK - Güncel Altın Fiyatları</title>
<link rel="stylesheet" href="css/tv.css">
</head>
<body>
<div class="user-dashboard">
<div id="tv-root">

  <!-- ============ UST BASLIK ============ -->
  <div id="tv-header">
    <div id="tv-brand">
      <img id="tv-logo" alt="" style="display:none" onerror="this.style.display='none'">
      <span class="dash-brand-badge" aria-hidden="true">
        <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="#D4AF62" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="20" x2="6" y2="13"></line>
          <line x1="12" y1="20" x2="12" y2="8"></line>
          <line x1="18" y1="20" x2="18" y2="15"></line>
        </svg>
      </span>
      <span class="dash-title-wrap">
        <span id="tv-brand-name">ALTU&#286; KUYUMCULUK</span>
        <span class="dash-title">G&#252;ncel Alt&#305;n Fiyatlar&#305;</span>
        <span class="dash-subtitle">Canl&#305; ve Anl&#305;k Piyasa Verileri</span>
      </span>
    </div>

    <div class="dash-meta">
      <div id="tv-datetime">
        <span id="tv-date">--.----.----</span>
        <span id="tv-clock">--:--:--</span>
      </div>
      <div id="tv-live">
        <span id="tv-live-dot" class="dot dot-gray"></span><span id="tv-live-text">BA&#286;LANIYOR...</span>
      </div>
    </div>
  </div>

  <!-- ============ ORTA: SOL F&#304;YAT TABLOSU + SA&#286; V&#304;TR&#304;N ============ -->
  <div id="tv-main">
    <div id="tv-products-panel">
      <div id="tv-products-head">
        <span class="tv-head-icon"></span>
        <span id="tv-col-name">&#220;R&#220;N</span>
        <span id="tv-col-buy">ALI&#350;</span>
        <span id="tv-col-sell">SATI&#350;</span>
        <span class="tv-head-dir"></span>
      </div>
      <div id="tv-products-body"><!-- satirlar js ile --></div>
    </div>

    <div id="tv-ads-panel">
      <div id="tv-ad-frame">
        <img id="tv-ad-img" src="" alt="" style="display:none">
        <div id="tv-ad-text"></div>
        <div id="tv-ad-default">
          <span class="ad-gem" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#D4AF62" stroke-width="1.4" stroke-linejoin="round">
              <path d="M6 3h12l3 5-9 12L3 8z"></path>
              <path d="M3 8h18"></path>
              <path d="M9 3l-2 5 5 12 5-12-2-5"></path>
            </svg>
          </span>
          <div class="ad-gold-line"></div>
          <div class="ad-title">ALTU&#286; KUYUMCULUK</div>
          <div class="ad-sub">Zarafetin I&#351;&#305;lt&#305;s&#305;n&#305; Ke&#351;fedin</div>
          <div class="ad-gold-line"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ D&Ouml;V&#304;Z SER&#304;D&#304; ============ -->
  <div id="tv-currency-box">
    <div id="tv-usd" class="cur-block">
      <span class="cur-name">USD</span>
      <span class="cur-buy" data-cur="usd-buy">-</span>
      <span class="cur-sell" data-cur="usd-sell">-</span>
    </div>
    <div id="tv-eur" class="cur-block">
      <span class="cur-name">EUR</span>
      <span class="cur-buy" data-cur="eur-buy">-</span>
      <span class="cur-sell" data-cur="eur-sell">-</span>
    </div>
  </div>

  <!-- ============ ALT: G&#304;VEN BLOKLARI + DURUM ============ -->
  <div id="tv-footer">
    <div class="dash-trust">
      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D4AF62" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
        </span>
        <span class="trust-text">
          <span class="trust-title">G&#252;venilir Veri</span>
          <span class="trust-desc">Do&#287;rudan canl&#305; piyasa verisi</span>
        </span>
      </div>

      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D4AF62" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 4 14 11 14 10 22 20 10 13 10 13 2"></polygon>
          </svg>
        </span>
        <span class="trust-text">
          <span class="trust-title">Anl&#305;k Güncelleme</span>
          <span class="trust-desc">Veriler ba&#287;lant&#305; geldik&#231;e tazelenir</span>
        </span>
      </div>

      <div class="trust-item">
        <span class="trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D4AF62" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="11" width="14" height="9" rx="2"></rect>
            <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
          </svg>
        </span>
        <span class="trust-text">
          <span class="trust-title">G&#252;venli Altyap&#305;</span>
          <span class="trust-desc">G&#252;venlik kurallar&#305;yla korunan ekran</span>
        </span>
      </div>
    </div>

    <div id="tv-status-box">
      <div><span class="lbl">Son G&#252;ncelleme:</span><span id="tv-updated">-</span></div>
      <div id="tv-note" class="tv-note"></div>
      <div class="tv-contact">
        <div class="tv-contact-row"><span class="lbl">TEL:</span><span id="tv-phone">0543 240 52 02</span></div>
        <div class="tv-contact-row"><span class="lbl">ADRES:</span><span id="tv-address">Atat&#252;rk Mah. Adeviye Bulvar&#305; No:50/D, Kahta <span class="tv-contact-note">&middot; Belediye soka&#287;&#305; d&#246;nmeden k&#246;&#351;e ba&#351;&#305;</span></span></div>
        <a id="tv-whatsapp" class="tv-whatsapp" href="#" target="_blank" rel="noopener" style="display:none">
          <svg class="wa-ico" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          <span>WhatsApp ile yaz</span>
        </a>
      </div>
      <a id="tv-admin-link" class="tv-admin-link" href="login.html" title="Y&#246;netim paneli">&#183; Y&#246;netim</a>
    </div>
  </div>

  <button id="tv-theme-toggle" class="tv-theme-toggle" type="button" title="Temay&#305; de&#287;i&#351;tir" aria-label="Temay&#305; de&#287;i&#351;tir" style="display:none">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path>
    </svg>
  </button>

  <!-- ============ G&#220;NCEL DE&#286;&#304;L UYARISI ============ -->
  <div id="tv-stale-bar" style="display:none">
    F&#304;YATLAR G&#220;NCEL DE&#286;&#304;L &mdash; SON GE&#199;ERL&#304; VER&#304; G&#214;STER&#304;L&#304;YOR
  </div>
</div>
</div>

<!-- TV okumalari Firebase REST (.json) + Harem Socket.IO ile yapilir; agir/eski
     v8 SDK bu sayfada ARTIK YUKLENMEZ: (1) tarayicidaki SDK snapshot cokmesinden
     (isEmpty) bagimsiz, (2) daha hizli acilis. Yonetim paneli (admin.html) SDK'yi
     yazma/giris icin ayrica kullanir; oraya dokunulmadi. -->
<script src="js/config.js"></script>
<script src="js/price-validator.js"></script>
<script src="js/price-engine.js"></script>
<script src="js/price-formatter.js"></script>
<script src="js/db.js"></script>
<script src="js/tv.js"></script>
</body>
</html>
